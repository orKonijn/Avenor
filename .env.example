# Local development defaults. Supply secrets in the hosting dashboard, never Git.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/avenor.sqlite
# NODE_ENV=production
# APP_ORIGIN=https://your-app.onrender.com
# Render's RENDER_EXTERNAL_URL is used when APP_ORIGIN is omitted.
# TRUST_PROXY_HOPS=1  # only behind Render's reverse proxy
# ENABLE_LOCAL_ACCOUNTS=true
# PRIVATE_ACCOUNT_EMAILS=your-email@example.com
# ENABLE_DEMO=false
# RESEND_API_KEY=server-only-key
# EMAIL_FROM=Avenor <mail@your-verified-domain.example>
# For an owner-only pilot, Resend's onboarding@resend.dev sends only to its account owner.
# TWELVE_DATA_API_KEY=server-only-key
# MARKET_DATA_USE=personal
# Optional legacy local email adapter instead of Resend:
# EMAIL_WEBHOOK_URL=https://your-adapter.example/deliver
# EMAIL_WEBHOOK_SECRET=server-only-secret
